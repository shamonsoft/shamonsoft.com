void over(inout vec4 dest,vec3 rgb,float alpha){alpha=clamp(alpha,0.,1.);dest=vec4(rgb*alpha,alpha)+dest*(1.-alpha);}
vec4 drawSurface(vec2 p){p=floor(p);vec4 f=fieldAt(p);float d=f.y,coverage=f.x,extrusion=uSide*.032*SExtrusion/100.*(uChannel==0.?1.:uChannel==1.?.22:.55),angle=SLightAngle*PI/180.;if(coverage==0.&&SGlow==0.&&d< -extrusion-uSide*.03-3.)return vec4(0);vec2 uv=(p+.5)/uSide;vec3 tint=colorAt(uv,false),accent=colorAt(uv,true);if(uChannel==1.)tint=mix(tint,accent,.45);vec4 result=vec4(0);if(coverage<1.){vec2 shadow=-vec2(cos(angle),sin(angle))*uSide*.018;float sd=fieldAt(vec2(ivec2(p-shadow-extrusion*vec2(.6,.8)))).y,sh=clamp(.5+sd/max(1.,uSide*.012),0.,1.)*LShadow/100.*(uChannel==1.?.08:.35)*(1.-coverage);if(sh>.001)over(result,vec3(.004),sh);if(SGlow>0.&&d<0.){float glow=exp(d/max(1.,uSide*.014))*SGlow/100.*.22;if(glow>.002)over(result,tint*1.4,glow);}if(extrusion>.01&&d> -extrusion-2.){int steps=max(2,int(ceil(extrusion*2.)));float maximum=-1.e20;vec2 hit=p;for(int s=0;s<=64;s++){if(s>steps)break;vec2 q=p-extrusion*float(s)/float(steps)*vec2(.6,.8);if(any(lessThan(q,vec2(0)))||any(greaterThan(q,vec2(uSide-1.))))continue;float value=fieldSample(q).y;if(value>maximum){maximum=value;hit=q;}}float alpha=clamp(maximum+.5,0.,1.);if(alpha>0.){float stepSize=max(1.5,uSide/192.);vec3 n=normalize(vec3(-(fieldSample(hit+vec2(stepSize,0)).y-fieldSample(hit-vec2(stepSize,0)).y)/(2.*stepSize),-(fieldSample(hit+vec2(0,stepSize)).y-fieldSample(hit-vec2(0,stepSize)).y)/(2.*stepSize),.22));over(result,illuminate(materialAt(uv,tint,accent),n,uv,.65)*.7,alpha);}}}
