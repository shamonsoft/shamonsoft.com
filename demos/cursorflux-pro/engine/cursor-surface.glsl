vec3 environmentAt(vec3 r,float rough){vec3 base=LEnvironment==2.?mix(vec3(.12,.16,.2),vec3(.65,.85,1.15),clamp(.5-r.y*.5,0.,1.)):vec3(.13,.17,.22);float spread=.035+rough*rough*.7;float left=exp(-pow((r.x+.48)/(spread+.17),2.)-pow((r.y+.38)/(spread+.55),4.)),right=exp(-pow((r.x-.65)/(spread+.1),2.)-pow((r.y-.12)/(spread+.65),4.)),top=exp(-pow((r.y+.72)/(spread+.12),2.));return base+(vec3(2.2,2.3,2.5)*left+vec3(.7,.95,1.3)*right+vec3(.8)*top)*(LEnvironment==1.?.75:1.);}
